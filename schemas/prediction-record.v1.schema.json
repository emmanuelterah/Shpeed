{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shpeed.dev/schemas/prediction-record.v1.schema.json",
  "title": "PredictionRecord",
  "description": "One published race prediction with provenance. Immutable once the race starts.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "season", "round", "data_cutoff", "snapshot_id", "model_version", "git_commit", "n_sims", "seed", "drivers"],
  "properties": {
    "schema_version": { "const": 1 },
    "season": { "type": "integer", "minimum": 1950 },
    "round": { "type": "integer", "minimum": 1 },
    "event_name": { "type": "string" },
    "data_cutoff": { "type": "string", "format": "date-time", "description": "Latest data the model was allowed to see (end of qualifying)" },
    "snapshot_id": { "type": "integer", "minimum": 0, "description": "DuckLake snapshot the run read (ADR-0002)" },
    "model_version": { "type": "string" },
    "git_commit": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" },
    "n_sims": { "type": "integer", "minimum": 1 },
    "seed": { "type": "integer" },
    "p_rain": { "type": "number", "minimum": 0, "maximum": 1 },
    "drivers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["driver_id", "p_position", "p_dnf"],
        "properties": {
          "driver_id": { "type": "string" },
          "display_name": { "type": "string" },
          "team_id": { "type": "string" },
          "grid": { "type": "integer", "minimum": 0 },
          "p_position": { "type": "array", "items": { "type": "number", "minimum": 0, "maximum": 1 }, "description": "P(finish in position k) for k = 1..n; with p_dnf sums to 1" },
          "p_dnf": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    },
    "score": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "brier_win": { "type": "number" },
        "brier_podium": { "type": "number" },
        "log_loss": { "type": "number" },
        "rps": { "type": "number" },
        "scored_at": { "type": "string", "format": "date-time" }
      }
    }
  }
}
